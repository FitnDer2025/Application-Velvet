NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://velvet:change-me@localhost:5432/velvet
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000,http://localhost:4173
COOKIE_DOMAIN=
COOKIE_SECURE=false
JWT_ISSUER=https://auth.velvet.local
JWT_ACCESS_TTL_SECONDS=900
JWT_PRIVATE_KEY_BASE64=generate-with-npm-run-secrets-dev
JWT_PUBLIC_KEY_BASE64=generate-with-npm-run-secrets-dev
PASSWORD_PEPPER_BASE64=generate-with-npm-run-secrets-dev
ENCRYPTION_ACTIVE_KEY_ID=v1
ENCRYPTION_KEYS_JSON={"v1":"generate-with-npm-run-secrets-dev"}
AUDIT_HMAC_KEY_BASE64=generate-with-npm-run-secrets-dev
INTEGRATION_SIGNING_KEY_BASE64=generate-with-npm-run-secrets-dev
INTEGRATION_WEBHOOKS_JSON={"members":"http://members:3000/internal/events","pro":"http://pro:3000/internal/events","control":"http://control:3000/internal/events"}
OUTBOX_DRY_RUN=true
AUTO_MIGRATE=false
