# Copie ce fichier en .env.internal.local puis complète uniquement les valeurs vides.
# Ne commit jamais .env.internal.local.

VELVET_TEST_AGENTS_ONLY=true
VELVET_ENVIRONMENT=staging
VELVET_INTERNAL_TEST_AGENTS=enabled
VELVET_TEST_AGENT_CYCLE_MS=60000
VELVET_TEST_AGENT_BATCH_SIZE=2

# Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=
DATABASE_SSL=require

# Facultatif : sans clé/modèle, Velvet utilise les réponses de secours intégrées.
OPENAI_API_KEY=
VELVET_TEST_AGENT_MODEL=gpt-5-mini
